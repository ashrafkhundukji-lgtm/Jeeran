{
  "expo": {
    "name": "جيران للأعمال",
    "slug": "jeeran-business",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jeeranbusiness",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF8F1",
    "ios": {
      "bundleIdentifier": "com.jeeran.business",
      "supportsTablet": false
    },
    "android": {
      "package": "com.jeeran.business",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFF8F1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportsRTL": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Jeeran Business uses your location once, to place your shop on the map for nearby customers."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/ReadexPro-Medium.ttf",
            "./assets/fonts/ReadexPro-SemiBold.ttf",
            "./assets/fonts/ReadexPro-Bold.ttf",
            "./assets/fonts/IBMPlexSansArabic-Regular.ttf",
            "./assets/fonts/IBMPlexSansArabic-Medium.ttf",
            "./assets/fonts/IBMPlexSansArabic-SemiBold.ttf",
            "./assets/fonts/IBMPlexSansArabic-Bold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8F1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/withAsciiProjectName"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
